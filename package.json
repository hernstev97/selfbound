{
  "name": "selfbound",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node tooling/local.mjs --seed small --app dev",
    "local": "node tooling/local.mjs",
    "build": "pnpm --filter @selfbound/app build",
    "typecheck": "pnpm -r --filter ./backend --filter ./core --filter ./app --filter ./e2e --filter ./perf --filter ./site typecheck",
    "test": "pnpm -r --filter ./backend --filter ./core --filter ./app --filter ./site test",
    "test:tooling": "node --test tooling/test/*.test.mjs",
    "e2e": "pnpm --filter @selfbound/e2e test",
    "perf": "node perf/run.ts --full",
    "perf:quick": "node perf/run.ts --quick",
    "perf:record": "node perf/record.ts",
    "convex": "node tooling/convex.mjs",
    "site:dev": "pnpm --filter @selfbound/site dev",
    "site:build": "pnpm --filter @selfbound/site build",
    "site:deploy": "node tooling/deploy-site.mjs"
  },
  "devDependencies": {
    "convex": "1.46.0"
  }
}
