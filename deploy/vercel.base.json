{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [],
  "rewrites": [
    { "source": "/", "missing": [{ "type": "cookie", "key": "xlr8_signed_in" }], "destination": "/welcome.html" },
    { "source": "/sign-in", "destination": "/welcome.html" },
    { "source": "/((?!assets/).*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Vary", "value": "Cookie" }] },
    { "source": "/(app|welcome).html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(sw.js|version.json|site.webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
