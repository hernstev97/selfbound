---
// App screenshot in light and dark: src/assets/screenshots/<name>-light.png and <name>-dark.png
// (either may be missing). The one matching the docs theme is shown.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  caption?: string;
  /** Narrow shots (dialogs, menus) are not stretched to the full column */
  width?: number;
}
const { name, alt, caption, width } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const light = files[`../assets/screenshots/${name}-light.png`]?.default;
const dark = files[`../assets/screenshots/${name}-dark.png`]?.default;
if (!light && !dark) throw new Error(`Screenshot "${name}" not found in src/assets/screenshots/`);
const style = width ? `max-width: ${width}px` : undefined;
// Up to the home page column (56rem); sharp on 2x screens.
const widths = [800, 1200, 1800];
const sizes = width ? `(min-width: ${width}px) ${width}px, 100vw` : '(min-width: 50rem) 56rem, 100vw';
---

<figure class="xl-shot" style={style}>
  {light && <Image src={light} alt={alt} class:list={['xl-shot-img', dark && 'xl-shot-light']} {widths} {sizes} />}
  {dark && <Image src={dark} alt={alt} class:list={['xl-shot-img', light && 'xl-shot-dark']} {widths} {sizes} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
