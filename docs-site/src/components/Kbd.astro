---
// One or more shortcuts in the app's notation: <Kbd keys="mod+k" />, <Kbd keys={['j', 'arrowdown']} />.
import { combo } from '../lib/keys';

interface Props {
  keys: string | string[];
}
const list = Array.isArray(Astro.props.keys) ? Astro.props.keys : [Astro.props.keys];
---

<span class="xl-kbds">
  {
    list.map((keys, i) => (
      <>
        {i > 0 && <span class="xl-kbd-or">or</span>}
        <span class="xl-combo">
          {combo(keys).map((step, s) => (
            <>
              {s > 0 && <span class="xl-kbd-then">then</span>}
              {step.map((cap) => (
                <kbd class="xl-kbd" title={cap.name} data-mac={cap.mac}>
                  {cap.label}
                </kbd>
              ))}
            </>
          ))}
        </span>
      </>
    ))
  }
</span>
