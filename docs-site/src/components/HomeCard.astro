---
// Link card for the home page grid. Icons are Lucide outlines (ISC), inlined to stay small.
interface Props {
  title: string;
  href: string;
  icon: keyof typeof ICONS;
}
const ICONS = {
  book: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  bot: '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  keyboard: '<path d="M10 8h.01"/><path d="M12 12h.01"/><path d="M14 8h.01"/><path d="M16 12h.01"/><path d="M18 8h.01"/><path d="M6 8h.01"/><path d="M7 16h10"/><path d="M8 12h.01"/><rect width="20" height="16" x="2" y="4" rx="2"/>',
  'pull-request': '<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M6 9v12"/>',
};
const { title, href, icon } = Astro.props;
---

<a class="xl-card not-content" href={href}>
  <span class="xl-card-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[icon]} />
  </span>
  <span class="xl-card-title">{title}</span>
  <span class="xl-card-text"><slot /></span>
</a>

<style>
  .xl-card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.875rem;
    row-gap: 0.25rem;
    align-items: center;
    align-content: start;
    padding: 1rem 1.125rem;
    border-radius: var(--xl-radius-lg);
    background: var(--xl-bg-panel);
    box-shadow: 0 0 0 var(--xl-panel-edge) var(--xl-border);
    color: inherit;
    text-decoration: none;
    transition:
      background-color 0.15s var(--xl-ease),
      box-shadow 0.15s var(--xl-ease);
  }
  .xl-card:hover {
    background: var(--xl-bg-hover);
    box-shadow: 0 0 0 var(--xl-panel-edge) var(--xl-border-strong);
  }
  .xl-card-icon {
    grid-row: 1;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--xl-radius);
    background: var(--xl-bg-control);
    box-shadow: inset 0 0 0 1px var(--xl-border-strong);
    color: var(--xl-text);
  }
  :global(:root[data-theme='light']) .xl-card-icon {
    background: oklch(1 0 0);
  }
  .xl-card:hover .xl-card-icon {
    color: var(--xl-accent-text);
  }
  .xl-card-icon svg {
    width: 1.0625rem;
    height: 1.0625rem;
  }
  .xl-card-title {
    color: var(--xl-text-strong);
    font-size: 1rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .xl-card-text {
    grid-column: 2;
    color: var(--xl-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
