---
// Starlight's footer (edit link, pagination) plus licence and links to the website and repository.
import Default from '@astrojs/starlight/components/Footer.astro';
import { LANDING_URL, REPO_URL } from '../../launch.mjs';
---

<Default />
<div class="xl-site-footer">
  <p>
    <a href={`${REPO_URL}/blob/main/LICENSE`}>AGPL-3.0</a> · © 2026 Steven Hernandez and contributors
  </p>
  <nav aria-label="Selfbound">
    <a href={LANDING_URL}>selfbound.kiumu.app</a>
    <a href={REPO_URL}>GitHub</a>
    <a href="/impressum/" lang="de">Impressum</a>
    <a href="/datenschutz/" lang="de">Datenschutz</a>
  </nav>
</div>

<script>
  // Wide tables scroll sideways (theme.css); like Expressive Code does for code blocks, make the
  // ones that overflow focusable so keyboard users can scroll them.
  const tables = document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table');
  const mark = () => {
    for (const t of tables) {
      if (t.scrollWidth > t.clientWidth) t.tabIndex = 0;
      else t.removeAttribute('tabindex');
    }
  };
  mark();
  addEventListener('resize', mark, { passive: true });
</script>
