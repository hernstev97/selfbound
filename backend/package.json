{
  "name": "@selfbound/backend",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./convex/_generated/api.js",
    "./dataModel": "./convex/_generated/dataModel.d.ts",
    "./shared/*": "./convex/shared/*.ts",
    "./constants": "./convex/shared/constants.ts",
    "./data": "./data/generate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p . && tsc --noEmit -p test/lib && tsc --noEmit -p ../tooling/linear-import",
    "test:lib": "vitest run -c vitest.lib.config.ts",
    "test": "vitest run",
    "test:integration": "node test/integration/run.mjs"
  },
  "dependencies": {
    "convex": "1.46.0",
    "convex-helpers": "0.1.125",
    "fractional-indexing": "4.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.19.1",
    "convex-test": "0.0.60",
    "graphql": "17.0.2",
    "jose": "6.2.12",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
