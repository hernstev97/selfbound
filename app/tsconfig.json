{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "svelte"]
  },
  "include": ["src", "test", "vite.config.ts", "vite.plugins.ts", "vite.notices.ts", "vite.welcome.config.ts", "vitest.config.ts"]
}
